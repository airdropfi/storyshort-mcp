{
  "name": "@storyshort/mcp-server",
  "version": "2.0.0",
  "description": "MCP server for StoryShort.org — AI video generation via Claude, Cursor, and other MCP clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "storyshort-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "storyshort",
    "ai-video",
    "claude",
    "cursor"
  ],
  "author": "StoryShort (https://storyshort.app)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airdropfi/storyshort-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
